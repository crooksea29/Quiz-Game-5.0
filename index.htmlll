<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Interactive School Subject Quiz</title>
    <style>
        /* Base Styling */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #f3f4f6;
            color: #1f2937;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        /* Container Layout */
        .quiz-container {
            background-color: #ffffff;
            max-width: 600px;
            width: 100%;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }

        h1 {
            font-size: 24px;
            color: #1e3a8a;
            margin-bottom: 10px;
            text-align: center;
        }

        .status-bar {
            display: flex;
            justify-content: space-between;
            margin-bottom: 25px;
            font-size: 14px;
            font-weight: bold;
            color: #4b5563;
        }

        /* Question & Options Design */
        .prompt {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 20px;
        }

        .options-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .option-btn {
            background-color: #f9fafb;
            border: 2px solid #e5e7eb;
            padding: 14px 20px;
            border-radius: 8px;
            text-align: left;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .option-btn:hover {
            background-color: #eff6ff;
            border-color: #3b82f6;
        }

        /* Feedback Screen Alert styling */
        .feedback {
            margin-top: 20px;
            padding: 12px;
            border-radius: 6px;
            text-align: center;
            font-weight: bold;
            display: none;
        }

        .feedback.correct {
            background-color: #d1fae5;
            color: #065f46;
        }

        .feedback.incorrect {
            background-color: #fee2e2;
            color: #991b1b;
        }

        /* Restart Button */
        .restart-btn {
            display: block;
            width: 100%;
            background-color: #2563eb;
            color: white;
            border: none;
            padding: 14px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 20px;
        }

        .restart-btn:hover {
            background-color: #1d4ed8;
        }
    </style>
</head>
<body>

    <div class="quiz-container">
        <h1>Welcome to the Quiz Game!</h1>
        <div class="status-bar" id="statusBar" style="display: none;">
            <span id="progressText">Question 1 of 6</span>
            <span id="scoreText">Score: 0</span>
        </div>

        <div id="quizBody">
            <!-- Content dynamically changes via JavaScript -->
        </div>

        <div class="feedback" id="feedbackBox"></div>
    </div>

    <script>
        // Database storing your exact question chains from the Python script
        const quizData = {
            math: [
                { q: "What is 42 * 3?", a: "134", b: "126", c: "104", d: "138", correct: "b" },
                { q: "Solve: 134 - 126.", a: "16", b: "14", c: "8", d: "12", correct: "c" },
                { q: "Solve for x: 2x + 2 = 12.", a: "7", b: "6", c: "2", d: "5", correct: "d" },
                { q: "Solve for x: x² - 9 = 0.", a: "+- 3", b: "4", c: "3, -3", d: "12", correct: "c" }, // matches 'c' or 'a' from Python logic
                { q: "Simplify: 51/34.", a: "2/3", b: "4/3", c: "3/2", d: "3/4", correct: "c" },
                { q: "Solve for x: x² - 8x + 16 = 0.", a: "4", b: "2", c: "8", d: "16", correct: "a" }
            ],
            science: [
                { q: "Who invented the laws of motion?", a: "Albert Einstein", b: "John Locke", c: "Marie Curie", d: "Sir Isaac Newton", correct: "d" },
                { q: "Which color absorbs the most wavelengths of light?", a: "Blue", b: "Black", c: "White", d: "Gray", correct: "b" },
                { q: "What was one of Einstein's ideas?", a: "Theory of Relativity", b: "Heliocentric Model", c: "The Periodic Table of Elements", d: "Ideal Gas Law", correct: "a" },
                { q: "Which gas law relates pressure and volume?", a: "Gay-Lussac's Law", b: "Charles Law", c: "Boyles Law", d: "Combined Gas Law", correct: "c" },
                { q: "Which phase change is exothermic?", a: "Vaporization", b: "Melting", c: "Sublimation", d: "Deposition", correct: "d" },
                { q: "What is a protein's monomer?", a: "Amino Acid", b: "Monosaccharid", c: "No True Monomer", d: "Nucleic Acid", correct: "a" }
            ],
            english: [
                { q: "Which comparison uses keywords 'like' or 'as'?", a: "Metaphor", b: "Simile", c: "Hyperbole", d: "Personification", correct: "b" },
                { q: "What does the 'E' in the acronym 'CER' stand for?", a: "Examples", b: "Explanation", c: "Evidence", d: "Extol", correct: "c" },
                { q: "What is a hook in the context of an essay?", a: "Something you use to catch fish", b: "A tool to hold objects or ideas", c: "The introduction to an essay", d: "The closing of an essay", correct: "c" },
                { q: "What is a hyperbole?", a: "A comparison between two unlike things", b: "A claim for an article", c: "A human trait in an inanimate object", d: "An extreme exaggeration", correct: "d" },
                { q: "What is the correct MLA citation form for a book?", a: "(Title, Page #)", b: "(Tile, Page #)", c: "(Title Page #)", d: "Title Page #", correct: "c" },
                { q: "What is the correct MLA format for the title of an article?", a: "'Title'", b: "Title", c: "title", d: "TITLE", correct: "a" }
            ],
            socialstudies: [
                { q: "What is the first amendment of the Bill of Rights?", a: "You have the right to a speedy and public trial", b: "Police have to have a warrant to search your stuff", c: "Freedom of speech", d: "You have the right to keep and bear weapons", correct: "c" },
                { q: "Which enlightenment thinker developed the idea of the social contract?", a: Jean-Jacques Rousseau", b: "Sir Francis Bacon", c: "John Locke", d: "Voltaire", correct: "a" }
            ]
        };

        // Game State Variables
        let score = 0;
        let currentSubject = "";
        let currentQuestionIndex = 0;

        const quizBody = document.getElementById("quizBody");
        const statusBar = document.getElementById("statusBar");
        const scoreText = document.getElementById("scoreText");
        const progressText = document.getElementById("progressText");
        const feedbackBox = document.getElementById("feedbackBox");

        // Initialization Screen: Pick Subject
        function loadSubjectSelection() {
            score = 0;
            currentQuestionIndex = 0;
            statusBar.style.display = "none";
            feedbackBox.style.display = "none";
            
            quizBody.innerHTML = `
                <p class="prompt">What is your favorite school subject?</p>
                <div class="options-list">
                    <button class="option-btn" onclick="startQuiz('math')">a. Math</button>
                    <button class="option-btn" onclick="startQuiz('science')">b. Science</button>
                    <button class="option-btn" onclick="startQuiz('english')">c. English</button>
                    <button class="option-btn" onclick="startQuiz('socialstudies')">d. Social Studies</button>
                </div>
            `;
        }

        // Transition from intro to questions
        function startQuiz(subject) {
            currentSubject = subject;
            statusBar.style.display = "flex";
            loadQuestion();
        }

        // Render Current Question
        function loadQuestion() {
            feedbackBox.style.display = "none";
            const questions = quizData[currentSubject];
            const qData = questions[currentQuestionIndex];

            progressText.innerText = `Question ${currentQuestionIndex + 1} of ${questions.length}`;
            scoreText.innerText = `Score: ${score}`;

            quizBody.innerHTML = `
                <p class="prompt">${qData.q}</p>
                <div class="options-list">
                    <button class="option-btn" onclick="checkAnswer('a')">a. ${qData.a}</button>
                    <button class="option-btn" onclick="checkAnswer('b')">b. ${qData.b}</button>
                    <button class="option-btn" onclick="checkAnswer('c')">c. ${qData.c}</button>
                    <button class="option-btn" onclick="checkAnswer('d')">d. ${qData.d}</button>
                </div>
            `;
        }

        // Evaluate validation logic
        function checkAnswer(userChoice) {
            const questions = quizData[currentSubject];
            const qData = questions[currentQuestionIndex];
            
            let isCorrect = userChoice === qData.correct;
            
            // Replicate Python edge case logic where Math question #4 accepts 'a' or 'c'
            if (currentSubject === 'math' && currentQuestionIndex === 3 && userChoice === 'a') {
                isCorrect = true;
            }

            if (isCorrect) {
                score++;
                feedbackBox.className = "feedback correct";
                feedbackBox.innerText = `Correct!`;
            } else {
